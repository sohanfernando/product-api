{
  "info": {
    "name": "Laravel Product API - Rate Limit Tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Separate rate-limit run. IMPORTANT: wait at least 65 seconds after ALL prior login/registration requests before running this collection. Run once, 1 iteration, 0 ms delay (finish in under 60 seconds). Allowlist 127.0.0.1 and enable cookie jar. Uses intentionally invalid inputs, creates no users or products. Expects first five same-email login attempts 422 then sixth 429; first three registration attempts 422 then fourth 429. Do not run concurrently with other API tests. Existing IP buckets can make limits fire early."
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    },
    {
      "key": "password",
      "value": "StrongPassword123!",
      "type": "string"
    },
    {
      "key": "new_password",
      "value": "AnotherStrongPassword123!",
      "type": "string"
    },
    {
      "key": "user_a_email",
      "value": "",
      "type": "string"
    },
    {
      "key": "user_b_email",
      "value": "",
      "type": "string"
    },
    {
      "key": "user_a_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "user_b_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "product_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "user_b_product_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "rate_email",
      "value": "",
      "type": "string"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const base = pm.variables.replaceIn(\"{{base_url}}\").replace(/\\/$/, \"\");",
          "const mode = pm.request.headers.get(\"X-Postman-CSRF-Mode\") || \"valid\";",
          "pm.request.headers.remove(\"X-Postman-CSRF-Mode\");",
          "pm.request.headers.remove(\"X-XSRF-TOKEN\");",
          "if (pm.info.requestName === \"01 - Rate tests initialize CSRF\") {",
          "    const run = Date.now().toString() + Math.random().toString(16).slice(2, 8);",
          "    pm.collectionVariables.set(\"user_a_email\", \"postman.a.\" + run + \"@example.test\");",
          "    pm.collectionVariables.set(\"user_b_email\", \"postman.b.\" + run + \"@example.test\");",
          "    pm.collectionVariables.set(\"rate_email\", \"postman.rate.\" + run + \"@example.test\");",
          "}",
          "const url = pm.variables.replaceIn(pm.request.url.toString());",
          "if (/\\/products\\//.test(url)) {",
          "    const id = url.split(\"/\").pop().split(\"?\")[0];",
          "    if (!/^[1-9][0-9]*$/.test(id)) {",
          "        pm.execution.setNextRequest(null);",
          "        throw new Error(\"Product ID is missing. Run the collection from the beginning.\");",
          "    }",
          "}",
          "if ([\"POST\", \"PUT\", \"PATCH\", \"DELETE\"].includes(pm.request.method)) {",
          "    if (mode === \"invalid\") {",
          "        pm.request.headers.upsert({key: \"X-XSRF-TOKEN\", value: \"intentionally-invalid-token\"});",
          "    } else if (mode !== \"missing\") {",
          "        pm.cookies.jar().get(base, \"XSRF-TOKEN\", (error, token) => {",
          "            if (error || !token) {",
          "                pm.execution.setNextRequest(null);",
          "                throw new Error(\"Cannot read XSRF-TOKEN. Allowlist 127.0.0.1 in Cookies > Domains Allowlist, enable the cookie jar, then run from request 01. \" + (error || \"\"));",
          "            }",
          "            pm.request.headers.upsert({key: \"X-XSRF-TOKEN\", value: decodeURIComponent(token)});",
          "        });",
          "    }",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 - Rate tests initialize CSRF",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 204\", () => pm.response.to.have.status(204));",
              "if (pm.response.code !== 204) {",
              "    pm.execution.setNextRequest(null);",
              "} else {",
              "",
              "",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Origin",
            "value": "{{base_url}}"
          }
        ],
        "url": "{{base_url}}/sanctum/csrf-cookie",
        "description": "Expected HTTP 204. Uses the collection-level cookie/CSRF script."
      }
    },
    {
      "name": "02 - Invalid login 1 of 5",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 422\", () => pm.response.to.have.status(422));",
              "if (pm.response.code !== 422) {",
              "    pm.execution.setNextRequest(null);",
              "} else {",
              "    const json = pm.response.json();",
              "    pm.test(\"Response is JSON\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
              "    pm.test(\"Expected validation fields\", () => { pm.expect(json.errors).to.have.property(\"email\"); });",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Origin",
            "value": "{{base_url}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{rate_email}}\",\n  \"password\": \"WrongPassword123!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{base_url}}/api/login",
        "description": "Expected HTTP 422. Uses the collection-level cookie/CSRF script."
      }
